<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14.0dip" />
            <stroke android:width="3.0dip" android:color="?t6c_accent_ff" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14.0dip" />
            <stroke android:width="2.0dip" android:color="?t6c_accent_bright_ff" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14.0dip" />
            <solid android:color="?t6c_accent_33" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14.0dip" />
            <stroke android:width="1.0dip" android:color="?t6c_border_ff" />
        </shape>
    </item>
</selector>
